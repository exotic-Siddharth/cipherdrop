# CipherDrop production configuration for docker-compose.prod.yml (docs/DEPLOYMENT.md).
#
#   cp .env.production.example .env.production        (.env.production is gitignored: never commit it)
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Nothing here is a real secret. Every value marked REQUIRED is a placeholder that the API REFUSES to start with
# ("change-me" is rejected by the production config guard), so an unfilled file fails fast instead of running.
# Plain KEY=value lines, no quotes, no spaces around "=".

# --- Public address -----------------------------------------------------------------------------------------------
# REQUIRED. The exact browser origin of the site: scheme + host (+ port), no path, no trailing slash.
# The API uses it for CORS and the refresh cookie assumes it is the page's own origin.
WEB_ORIGIN=https://drop.example.com
# Host address and port the web container (nginx) is published on. Loopback by default: put TLS in front of it
# (the Caddy profile below, or your own proxy). 0.0.0.0 exposes plain HTTP to the network.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Proxy hops whose X-Forwarded-For entry the API trusts for req.ip (rate limits, per-IP caps, audit IP prefixes):
#   1 = this stack, with or without Caddy (profile tls). nginx is the hop next to the API, and behind Caddy it
#       already takes the client from Caddy's header (set_real_ip_from in deploy/nginx.conf), so its entry is the client.
#       Upgrading a tls-profile install that has 2 (the old advice): change it to 1, or a client that reaches nginx's
#       port directly can choose its own address.
#   2 = your own reverse proxy / load balancer in front of nginx, not listed in set_real_ip_from. nginx then sees every
#       client behind it as one, so together they get its per-client cap: 64 in-flight /api requests for the whole
#       site. If the proxy reaches nginx from a fixed address, add that exact address (never a range) to
#       set_real_ip_from, rebuild the web image and keep 1. A proxy on this host that connects to 127.0.0.1:WEB_PORT
#       comes from a Docker gateway address that is not fixed: see docs/DEPLOYMENT.md before trusting it.
# A wrong value lets clients spoof their IP (too high) or puts every client on the proxy's IP (too low).
TRUST_PROXY=1
# Only with `--profile tls`: the public DNS name Caddy gets a certificate for (must match WEB_ORIGIN's host).
# Caddy runs at 172.16.94.2 on the compose network `edge` (172.16.94.0/28); see docker-compose.prod.yml if that
# subnet is taken on this host.
# SITE_ADDRESS=drop.example.com

# --- Database and Redis -------------------------------------------------------------------------------------------
# Compose writes these passwords into connection URLs, so use only URL-safe characters (openssl rand -hex is).
# REQUIRED. The bundled Postgres's owner role (cipherdrop, a superuser). Only the one-shot `migrate` service uses it:
# it applies the migrations and keeps the API's own role up to date.   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# REQUIRED, and different. cipherdrop_app, the role the API connects as: rows only, no schema changes. `migrate` sets
# this password on every start, so changing it here and running `up -d` again rotates it.   openssl rand -hex 24
POSTGRES_APP_PASSWORD=change-me-generate-a-different-value-hex-24
# REQUIRED. The bundled Redis (requirepass): it holds the revoked-session denylist and the rate limits.
#   openssl rand -hex 32
REDIS_PASSWORD=change-me-generate-with-openssl-rand-hex-32

# --- Secrets (REQUIRED) -------------------------------------------------------------------------------------------
# Generate each one separately and keep them out of version control and logs.
# JWT_ACCESS_SECRET and PRELOGIN_SECRET: at least 32 characters.   openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-32
PRELOGIN_SECRET=change-me-generate-a-different-value-0123
# TOTP_ENC_KEY: exactly 32 random bytes, base64 (encrypts TOTP secrets at rest).   openssl rand -base64 32
# Losing or rotating it makes every enrolled TOTP secret unreadable, and there is no admin reset of 2FA. Backup codes
# are stored as hashes, not under this key, and each works once: signing in uses one and turning 2FA off asks for
# another. So users with at least two unused codes (or one, while still signed in) can turn 2FA off and enrol again;
# everyone else is locked out (recovery also asks for a 2FA code). Back this key up with the database.
# The placeholder below is valid base64 of the text "change-me-change-me-change-me-ab" and is rejected as a placeholder.
TOTP_ENC_KEY=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtYWI=

# --- Cookies / sessions -------------------------------------------------------------------------------------------
# Must be true in production (the API refuses to start otherwise). Browsers only store a Secure cookie from an
# https:// page (http://localhost is the one exception), so TLS in front of nginx is required for real use.
COOKIE_SECURE=true
ACCESS_TOKEN_TTL_SEC=900
# Idle limit: a session ends this long after its last refresh (any open tab refreshes about every 15 minutes).
REFRESH_TOKEN_TTL_DAYS=30
# Absolute limit: a session ends this long after sign-in, however active it is, and the user signs in again (with
# the 2FA code when it is on). Must be at least REFRESH_TOKEN_TTL_DAYS; 30 follows NIST SP 800-63B for AAL1.
SESSION_MAX_LIFETIME_DAYS=30

# --- Blob storage -------------------------------------------------------------------------------------------------
# local: ciphertext on the `blobs` volume (single API instance only). s3: any S3-compatible store (R2, AWS S3, MinIO).
STORAGE_DRIVER=local
# For STORAGE_DRIVER=s3 (also used by `--profile minio`, which creates MinIO with these credentials):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com      (with --profile minio: http://minio:9000)
# S3_REGION=auto                                                 (R2 uses "auto"; MinIO "us-east-1")
# S3_BUCKET=cipherdrop
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true                                       (true for MinIO; R2 works with false)
# The API refuses to start on a bucket where a delete would not be final: with Object Lock always, and with
# versioning on unless S3_DELETE_ALL_VERSIONS=true (then every delete removes each version by its VersionId, which
# needs s3:ListBucketVersions and s3:DeleteObjectVersion). It reads the bucket's settings at start-up
# (s3:GetBucketObjectLockConfiguration, and s3:GetBucketVersioning unless S3_DELETE_ALL_VERSIONS=true).
# S3_DELETE_ALL_VERSIONS=false

# --- Vulnerability disclosure -------------------------------------------------------------------------------------
# /.well-known/security.txt (RFC 9116) is generated when the web image is built. Unset, it points at the CipherDrop
# project's private vulnerability reporting on GitHub, which is right for reports about the code. On your own
# instance, name who handles reports about it: one or more mailto:, tel: or https:// URIs (comma-separated, in order of
# preference), and optionally the https:// URL of your disclosure policy. After changing these, rebuild and restart
# the web image (docker compose ... up -d --build web). Its Expires is the build date plus 180 days. An unchanged
# rebuild reuses Docker's cached build step and keeps the old date, so renew it before then without the cache:
#   docker compose --env-file .env.production -f docker-compose.prod.yml build --no-cache web
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d web
# SECURITY_TXT_CONTACT=mailto:security@drop.example.com
# SECURITY_TXT_POLICY=https://drop.example.com/security-policy

# --- Hosting-abuse switches (docs/SECURITY.md) ---------------------------------------------------------------------
# The server cannot scan ciphertext, so who may upload is the operator's main lever. false answers 403
# FEATURE_DISABLED and the SPA explains it; drops already created still finish and stay downloadable.
# ALLOW_ANONYMOUS_UPLOADS=true
# ALLOW_REGISTRATION=true
# Ceiling on the bytes of ALL drops not purged yet, anonymous and signed in (0 = off). Set it below the space you
# can give blobs (the disk, or your bucket budget): quotas are per account and free accounts are cheap.
# GLOBAL_STORAGE_CAP_BYTES=0
# STORAGE_DRIVER=local: refuse new drops before the blobs volume, which shares the disk with Postgres, gets
# below this much free space (1 GiB; 0 = off). A full disk takes the database down.
# STORAGE_MIN_FREE_BYTES=1073741824

# --- Logging and limits (defaults shown; the full list is docs/DESIGN.md section 6) --------------------------------------
LOG_LEVEL=info
# ANON_MAX_DROP_BYTES=104857600
# USER_MAX_DROP_BYTES=2147483648
# USER_DEFAULT_QUOTA_BYTES=5368709120
# New accounts get at most 256 MiB for their first 7 days (0 days = no probation); an admin's quota edit ends it.
# NEW_ACCOUNT_QUOTA_BYTES=268435456
# NEW_ACCOUNT_PROBATION_DAYS=7
# Ceiling on the bytes of all anonymous drops not purged yet (10 GiB). 0 removes it: never on a public instance.
# ANON_TOTAL_PENDING_BYTES=10737418240
# Rolling budget per anonymous client (IPv4 address or IPv6 /48): 1 GiB per 24 h, then 429 + Retry-After. 0 = off.
# Counted in whole MiB per hour; it must be at least ANON_MAX_DROP_BYTES, so raise both together.
# ANON_BYTES_PER_CLIENT=1073741824
# ANON_BYTES_WINDOW_HOURS=24
# In-flight chunk transfers are capped per API PROCESS; with more than one API instance see docs/DEPLOYMENT.md.
# MAX_CONCURRENT_CHUNK_UPLOADS=64
# MAX_CONCURRENT_CHUNK_DOWNLOADS=192
# Server-side Argon2id of account auth keys, also per API process (apps/api/src/lib/argon2Limiter.ts explains the
# sizing): hashes at once, and how many more may wait before a request gets 429 + Retry-After. ARGON2_MAX_CONCURRENT
# must stay below UV_THREADPOOL_SIZE, which the API image sets to 8 (raise both together on a bigger host).
# ARGON2_MAX_CONCURRENT=2
# ARGON2_MAX_QUEUE=32

# Do NOT set RATE_LIMITS_ENABLED=false (refused in production) or any SEED_* value: production is not seeded.
# API_DOCS_UI=true is refused too: Swagger UI would run on the origin that holds the keys (deploy/nginx.conf answers
# 404 for /api/docs as well). The OpenAPI document stays at /api/openapi.json.
# VITE_DEMO_CREDENTIALS is a build-time SPA variable; the web image never receives it.
