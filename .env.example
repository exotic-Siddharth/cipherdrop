# CipherDrop: every variable of spec section 6 (documentation copy).
# The API reads apps/api/.env (template: apps/api/.env.example); the SPA reads apps/web/.env (template: apps/web/.env.example).
# docker-compose.yml needs no env file (dev credentials are inline and LOCAL DEV only).

# NODE_ENV=production additionally needs explicit DATABASE_URL, REDIS_URL, WEB_ORIGIN, TRUST_PROXY and COOKIE_SECURE=true.
NODE_ENV=development
API_PORT=4100
WEB_ORIGIN=http://localhost:5174

DATABASE_URL=postgresql://cipherdrop:cipherdrop@localhost:55433/cipherdrop?schema=public
REDIS_URL=redis://localhost:56380/0
# Prefix of every Redis key (rate limits, sid denylist, locks). Tests use a unique prefix.
KEY_PREFIX=cd

# Secrets (LOCAL DEV values only; generate real ones for production).
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-not-for-production-0001
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Absolute session lifetime: sign in again this long after sign-in, however active (>= REFRESH_TOKEN_TTL_DAYS).
SESSION_MAX_LIFETIME_DAYS=30
# Admin step-up: reporters' keys and review grants need a sign-in or re-authentication this recent (minutes).
ADMIN_STEP_UP_MINUTES=15
COOKIE_SECURE=false
# 32 bytes, base64. Encrypts TOTP secrets at rest. (base64 of "dev-only-totp-enc-key-32-bytes!!")
TOTP_ENC_KEY=ZGV2LW9ubHktdG90cC1lbmMta2V5LTMyLWJ5dGVzISE=
# HMAC key for deterministic fake prelogin salts (no user enumeration).
PRELOGIN_SECRET=dev-only-prelogin-hmac-secret-not-for-production-01

# Blob storage: local (default) or s3 (MinIO in docker-compose.yml).
STORAGE_DRIVER=local
# Relative paths resolve against apps/api (gitignored apps/api/data/).
STORAGE_DIR=./data/blobs
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=cipherdrop
S3_ACCESS_KEY_ID=cipherdrop
S3_SECRET_ACCESS_KEY=cipherdrop-dev-secret
S3_FORCE_PATH_STYLE=true
# A versioned bucket keeps every version under a plain delete, so the S3 driver refuses one unless this is true: it
# then deletes each version and delete marker by its VersionId. A bucket with Object Lock is always refused.
S3_DELETE_ALL_VERSIONS=false

# Limits (ciphertext bytes).
ANON_MAX_DROP_BYTES=104857600
USER_MAX_DROP_BYTES=2147483648
USER_DEFAULT_QUOTA_BYTES=5368709120
# New accounts: at most this quota for their first days (0 days = no probation). An admin's quota edit ends it.
NEW_ACCOUNT_QUOTA_BYTES=268435456
NEW_ACCOUNT_PROBATION_DAYS=7
ANON_MAX_EXPIRY_HOURS=72
USER_MAX_EXPIRY_HOURS=720
MAX_FILES_PER_DROP=20
DOWNLOAD_GRANT_TTL_MIN=30
CLEANUP_INTERVAL_SEC=60
CHUNK_IDLE_TIMEOUT_SEC=30
# Chunk PUT / GET in-flight caps (per process; 429 + Retry-After beyond them). The download cap stays below the 256-socket S3 pool.
CHUNK_UPLOAD_IDLE_TIMEOUT_SEC=30
CHUNK_UPLOAD_MIN_BYTES_PER_SEC=4096
MAX_CONCURRENT_CHUNK_UPLOADS=64
MAX_CHUNK_UPLOADS_PER_TOKEN=8
MAX_CHUNK_UPLOADS_PER_IP=16
MAX_CONCURRENT_CHUNK_DOWNLOADS=192
MAX_CHUNK_DOWNLOADS_PER_GRANT=8
# One download grant serves at most this many times the drop's ciphertext size (resume and retry fit in 3).
DOWNLOAD_GRANT_BYTE_FACTOR=3
MAX_CHUNK_DOWNLOADS_PER_IP=32
# Server-side Argon2id per process (429 + Retry-After past the queue). Must stay below UV_THREADPOOL_SIZE (libuv's
# default 4 here; the API image sets 8).
ARGON2_MAX_CONCURRENT=2
ARGON2_MAX_QUEUE=32
# libuv's threadpool size (Node's default 4), shared by Argon2id and file I/O. Read by libuv, not by the app, and only
# from the process environment at start-up, so set it there, not in apps/api/.env. The API image sets 8.
# UV_THREADPOOL_SIZE=8

# Hosting-abuse controls. Operator switches: false answers 403 FEATURE_DISABLED (drops already created still finish).
ALLOW_ANONYMOUS_UPLOADS=true
ALLOW_REGISTRATION=true
# Ceiling on the bytes of all anonymous drops not purged yet (0 = no ceiling).
ANON_TOTAL_PENDING_BYTES=10737418240
# Rolling budget per anonymous client (IPv4 address or IPv6 /48): bytes per window (0 = off). 429 + Retry-After beyond it.
# Counted in whole MiB per hour, so it must be at least ANON_MAX_DROP_BYTES rounded up to a MiB: raise both together.
ANON_BYTES_PER_CLIENT=1073741824
ANON_BYTES_WINDOW_HOURS=24
# Ceiling on the bytes of ALL drops not purged yet (0 = off), and the free-disk floor of local storage (0 = off):
# beyond either, new drops get 507 STORAGE_FULL.
GLOBAL_STORAGE_CAP_BYTES=0
STORAGE_MIN_FREE_BYTES=1073741824

# Reverse-proxy hop count for req.ip (0 = trust nothing; 1 behind nginx in production).
TRUST_PROXY=0
# Refused (false) when NODE_ENV=production; tests disable it unless they test limits.
RATE_LIMITS_ENABLED=true
LOG_LEVEL=info
LOG_PRETTY=false
# Swagger UI at /api/docs (LOCAL DEV only: off when unset, refused when NODE_ENV=production). /api/openapi.json is always served.
API_DOCS_UI=true

# Seed accounts (npm run db:seed). LOCAL DEV values.
SEED_ADMIN_PASSWORD=admin-cipherdrop-dev-2026
SEED_DEMO_PASSWORD=demo-cipherdrop-dev-2026

# --- Web (apps/web/.env, build-time) ---
# When set, the login page offers "Use demo account" (format email:password; key derivation stays client-side).
VITE_DEMO_CREDENTIALS=demo@cipherdrop.local:demo-cipherdrop-dev-2026
# /.well-known/security.txt contact and policy (build-time; unset = the CipherDrop project's own, see apps/web/.env.example).
# SECURITY_TXT_CONTACT=mailto:security@drop.example
# SECURITY_TXT_POLICY=https://drop.example/security-policy
