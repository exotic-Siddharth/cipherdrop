# CipherDrop production configuration for docker-compose.prod.yml (docs/DEPLOYMENT.md).
#
#   cp .env.production.example .env.production        (.env.production is gitignored: never commit it)
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Nothing here is a real secret. Every value marked REQUIRED is a placeholder that the API REFUSES to start with
# ("change-me" is rejected by the production config guard), so an unfilled file fails fast instead of running.
# Plain KEY=value lines, no quotes, no spaces around "=".

# --- Public address -----------------------------------------------------------------------------------------------
# REQUIRED. The exact browser origin of the site: scheme + host (+ port), no path, no trailing slash.
# The API uses it for CORS and the refresh cookie assumes it is the page's own origin.
WEB_ORIGIN=https://drop.example.com
# Host address and port the web container (nginx) is published on. Loopback by default: put TLS in front of it
# (the Caddy profile below, or your own proxy). 0.0.0.0 exposes plain HTTP to the network.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Proxy hops between the internet and the API, used for req.ip (rate limits, per-IP caps, audit IP prefixes):
#   1 = nginx only (the web container is the first thing that sees the client)
#   2 = Caddy (profile tls) or another reverse proxy / load balancer in front of nginx
# A wrong value lets clients spoof their IP (too high) or puts every client on the proxy's IP (too low).
TRUST_PROXY=1
# Only with `--profile tls`: the public DNS name Caddy gets a certificate for (must match WEB_ORIGIN's host).
# SITE_ADDRESS=drop.example.com

# --- Database -----------------------------------------------------------------------------------------------------
# REQUIRED. Password of the bundled Postgres. Compose puts it into DATABASE_URL, so use only URL-safe characters:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# --- Secrets (REQUIRED) -------------------------------------------------------------------------------------------
# Generate each one separately and keep them out of version control and logs.
# JWT_ACCESS_SECRET and PRELOGIN_SECRET: at least 32 characters.   openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-32
PRELOGIN_SECRET=change-me-generate-a-different-value-0123
# TOTP_ENC_KEY: exactly 32 random bytes, base64 (encrypts TOTP secrets at rest).   openssl rand -base64 32
# Losing or rotating it makes every enrolled TOTP secret unreadable (users would need a recovery or admin reset).
# The placeholder below is valid base64 of the text "change-me-change-me-change-me-ab" and is rejected as a placeholder.
TOTP_ENC_KEY=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtYWI=

# --- Cookies / sessions -------------------------------------------------------------------------------------------
# Must be true in production (the API refuses to start otherwise). Browsers only store a Secure cookie from an
# https:// page (http://localhost is the one exception), so TLS in front of nginx is required for real use.
COOKIE_SECURE=true
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Blob storage -------------------------------------------------------------------------------------------------
# local: ciphertext on the `blobs` volume (single API instance only). s3: any S3-compatible store (R2, AWS S3, MinIO).
STORAGE_DRIVER=local
# For STORAGE_DRIVER=s3 (also used by `--profile minio`, which creates MinIO with these credentials):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com      (with --profile minio: http://minio:9000)
# S3_REGION=auto                                                 (R2 uses "auto"; MinIO "us-east-1")
# S3_BUCKET=cipherdrop
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true                                       (true for MinIO; R2 works with false)

# --- Logging and limits (defaults shown; the full list is docs/DESIGN.md section 6) --------------------------------------
LOG_LEVEL=info
# ANON_MAX_DROP_BYTES=104857600
# USER_MAX_DROP_BYTES=2147483648
# USER_DEFAULT_QUOTA_BYTES=5368709120
# ANON_TOTAL_PENDING_BYTES=0
# In-flight chunk transfers are capped per API PROCESS; with more than one API instance see docs/DEPLOYMENT.md.
# MAX_CONCURRENT_CHUNK_UPLOADS=64
# MAX_CONCURRENT_CHUNK_DOWNLOADS=192

# Do NOT set RATE_LIMITS_ENABLED=false (refused in production) or any SEED_* value: production is not seeded.
# VITE_DEMO_CREDENTIALS is a build-time SPA variable; the web image never receives it.
