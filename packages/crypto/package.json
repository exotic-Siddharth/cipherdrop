{
  "name": "@cipherdrop/crypto",
  "version": "0.1.0",
  "private": true,
  "description": "Isomorphic CipherDrop cryptography (WebCrypto AES-256-GCM STREAM, HKDF, Argon2id via hash-wasm)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench": "tsx src/bench.ts"
  },
  "dependencies": {
    "hash-wasm": "^4.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "3.2"
  }
}
