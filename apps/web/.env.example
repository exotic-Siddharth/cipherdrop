# CipherDrop SPA environment. Copy to apps/web/.env (gitignored).
# Vite exposes only VITE_* variables to the browser bundle, at BUILD time.

# LOCAL DEV value (R24): when set, the login page offers "Use demo account" (format email:password; the
# password may contain ':'). Key derivation still happens in the browser. It must match SEED_DEMO_PASSWORD in
# apps/api/.env. Leave it unset for any real deployment: the value is baked into the JavaScript bundle.
VITE_DEMO_CREDENTIALS=demo@cipherdrop.local:demo-cipherdrop-dev-2026

# Dev/preview proxy target for /api (read by vite.config.ts only, never shipped to the browser).
# Default http://localhost:4100. The e2e config sets http://localhost:4101 (R2).
# API_PROXY_TARGET=http://localhost:4100
