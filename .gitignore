# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# env files: real values live in .env (gitignored); only *.env.example is committed
.env
.env.*
!.env.example

# tests and reports
coverage/
playwright-report/
test-results/
blob-report/

# local blob storage (STORAGE_DIR defaults to apps/api/data/blobs)
apps/api/data/

# logs and OS/editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Throwaway probe tests written by review agents (deleted before each review commit)
__review__/
