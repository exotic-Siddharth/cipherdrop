{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "DOM" is required: the API typechecks @cipherdrop/crypto's isomorphic TS source (seed, smoke, tests), which
    // uses the WebCrypto global types (CryptoKey, BufferSource, AesGcmParams); @types/node does not declare them.
    // Node timer typing (NodeJS.Timeout, .unref()) still resolves to @types/node.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src", "test", "prisma", "scripts", "vitest.config.ts", "tsup.config.ts"]
}
