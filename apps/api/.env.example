# CipherDrop API environment (spec section 6). Copy to apps/api/.env for local development.
# Every secret below is a clearly-marked LOCAL DEV value. The API refuses "dev-only" secrets when NODE_ENV=production.
# The API loads apps/api/.env via process.loadEnvFile() (existing environment variables win); the Prisma CLI loads it too.

# NODE_ENV=production additionally needs explicit DATABASE_URL, REDIS_URL, WEB_ORIGIN, TRUST_PROXY and COOKIE_SECURE=true.
NODE_ENV=development
API_PORT=4100
WEB_ORIGIN=http://localhost:5174

DATABASE_URL=postgresql://cipherdrop:cipherdrop@localhost:55433/cipherdrop?schema=public
REDIS_URL=redis://localhost:56380/0
# Prefix of every Redis key (rate limits, sid denylist, locks). Tests use a unique prefix.
KEY_PREFIX=cd

# Secrets (LOCAL DEV values only; generate real ones for production).
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-not-for-production-0001
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# 32 bytes, base64. Encrypts TOTP secrets at rest. (base64 of "dev-only-totp-enc-key-32-bytes!!")
TOTP_ENC_KEY=ZGV2LW9ubHktdG90cC1lbmMta2V5LTMyLWJ5dGVzISE=
# HMAC key for deterministic fake prelogin salts (no user enumeration).
PRELOGIN_SECRET=dev-only-prelogin-hmac-secret-not-for-production-01

# Blob storage: local (default) or s3 (MinIO in docker-compose.yml).
STORAGE_DRIVER=local
# Relative paths resolve against apps/api (gitignored apps/api/data/).
STORAGE_DIR=./data/blobs
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=cipherdrop
S3_ACCESS_KEY_ID=cipherdrop
S3_SECRET_ACCESS_KEY=cipherdrop-dev-secret
S3_FORCE_PATH_STYLE=true

# Limits (ciphertext bytes).
ANON_MAX_DROP_BYTES=104857600
USER_MAX_DROP_BYTES=2147483648
USER_DEFAULT_QUOTA_BYTES=5368709120
ANON_MAX_EXPIRY_HOURS=72
USER_MAX_EXPIRY_HOURS=720
MAX_FILES_PER_DROP=20
DOWNLOAD_GRANT_TTL_MIN=30
CLEANUP_INTERVAL_SEC=60
CHUNK_IDLE_TIMEOUT_SEC=30
# Chunk PUT / GET in-flight caps (per process; 429 + Retry-After beyond them). The download cap stays below the 256-socket S3 pool.
CHUNK_UPLOAD_IDLE_TIMEOUT_SEC=30
CHUNK_UPLOAD_DEADLINE_SEC=120
MAX_CONCURRENT_CHUNK_UPLOADS=64
MAX_CHUNK_UPLOADS_PER_TOKEN=8
MAX_CHUNK_UPLOADS_PER_IP=16
MAX_CONCURRENT_CHUNK_DOWNLOADS=192
MAX_CHUNK_DOWNLOADS_PER_GRANT=8
MAX_CHUNK_DOWNLOADS_PER_IP=32

# Reverse-proxy hop count for req.ip (0 = trust nothing; 1 behind nginx in production).
TRUST_PROXY=0
# Refused (false) when NODE_ENV=production; tests disable it unless they test limits.
RATE_LIMITS_ENABLED=true
LOG_LEVEL=info
LOG_PRETTY=false

# Seed accounts (npm run db:seed). LOCAL DEV values.
SEED_ADMIN_PASSWORD=admin-cipherdrop-dev-2026
SEED_DEMO_PASSWORD=demo-cipherdrop-dev-2026
